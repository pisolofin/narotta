# ==============================================================================
# Configurazione Ambiente Locale per NaRotta Docker Compose
# ==============================================================================
# Percorso per lo storage condiviso (output mappe .mbtiles, .db, .tar e manifest.json).
# - In locale: cartella relativa (es. ./data/output) o assoluta su Windows (es. C:/narotta-data/output)
# - In produzione su Linux / Coolify: fallback automatico a /var/data/shared-storage
SHARED_STORAGE_PATH=./data/output
