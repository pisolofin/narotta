# ==============================================================================
# Configurazione Ambiente Locale per NaRotta Docker Compose
# ==============================================================================

# Percorso per lo storage condiviso locale (docker-compose.yml)
# - In locale: cartella relativa (es. ./data/output) o assoluta su Windows (es. C:/narotta-data/output)
# - In produzione su Linux / Coolify: fallback automatico a /var/data/shared-storage
SHARED_STORAGE_PATH=./data/output

# ==============================================================================
# Configurazione NAS per esecuzione locale con storage remoto (docker-compose.local-nas.yml)
# ==============================================================================
# Percorso di montaggio della cartella output del NAS all'interno di WSL/Docker Desktop
# (montato automaticamente da run-local-nas.bat via drvfs senza richiedere password)
NAS_OUTPUT_PATH=/mnt/wsl/narotta/output

# Percorso di rete UNC su Synology NAS
NAS_UNC_PATH=\\192.168.8.53\docker\narotta\output

# Porte esposte in locale
MAP_BUILDER_PORT=8080
MAP_API_PORT=5001

# URL base per l'API e il download delle mappe
PUBLIC_BASE_URL=http://localhost:5001
BASE_URL=http://localhost:5001/maps/
