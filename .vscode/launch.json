{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "NaRotta (Auto Style)",
      "cwd": "flutter",
      "request": "launch",
      "type": "dart"
    },
    {
      "name": "NaRotta - Windows (Material Style)",
      "cwd": "flutter",
      "request": "launch",
      "type": "dart",
      "deviceId": "windows",
      "args": [
        "--dart-define",
        "UI_STYLE=material"
      ]
    },
    {
      "name": "NaRotta - Windows (Cupertino Style)",
      "cwd": "flutter",
      "request": "launch",
      "type": "dart",
      "deviceId": "windows",
      "args": [
        "--dart-define",
        "UI_STYLE=cupertino"
      ]
    },
    {
      "name": "NaRotta (Profile Mode)",
      "cwd": "flutter",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile"
    },
    {
      "name": "NaRotta (Release Mode)",
      "cwd": "flutter",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release"
    }
  ]
}